# Ready Reply settings. Copy this file to .env and change what you need.
# The start scripts create .env automatically the first time.

# Interface language: es (Spanish) or en (English)
RR_LOCALE=es

# Where the data is stored (a single file on this computer)
RR_DATABASE_URL=sqlite:///./data/readyreply.db

# 0.0.0.0 lets phones on the same Wi-Fi open the app. Use 127.0.0.1 to allow only this computer.
RR_HOST=0.0.0.0
RR_PORT=8000
RR_OPEN_BROWSER=true

# Hours a login lasts without activity
RR_SESSION_HOURS=12

# Set to true only if you serve Ready Reply over HTTPS (for example behind a proxy)
RR_COOKIE_SECURE=false

# Extra host names allowed in the browser address, comma separated (IP addresses,
# localhost, the computer's own name and *.local always work)
RR_ALLOWED_HOSTS=

# Upload limits in bytes: CSV import, and any other request
RR_MAX_CSV_BYTES=1048576
RR_MAX_REQUEST_BYTES=524288
# Total size of the WhatsApp chats imported at once
RR_MAX_CHAT_BYTES=20971520

# --- Optional AI (free) ---
# ollama: free AI that runs on this computer (install from ollama.com, then: ollama pull gemma3:4b)
# manual: shows a text to copy into any AI website and paste the reply back
# openai_compatible: any provider with an OpenAI-compatible API (needs RR_AI_API_KEY)
RR_AI_PROVIDER=ollama
RR_AI_MODEL=gemma3:4b
RR_AI_BASE_URL=http://127.0.0.1:11434
RR_AI_TIMEOUT_SECONDS=60
# Optional website opened by the manual mode, for example a free AI chat
RR_AI_CHAT_URL=
# Secret. Only for openai_compatible. Never share this file.
RR_AI_API_KEY=
